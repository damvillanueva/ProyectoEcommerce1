# Copie este archivo como .env y reemplace todos los valores antes de iniciar Docker.
# JWT_SECRET debe ser aleatorio y tener al menos 64 caracteres.
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_64_CARACTERES_O_MAS
JWT_EXPIRATION_MS=900000

# Origen exacto desde el que se sirve el frontend.
SMARTLOGIX_CORS_ALLOWED_ORIGIN=http://127.0.0.1:5174
SMARTLOGIX_CORS_ALLOWED_ORIGIN_ALT=http://localhost:5174
SMARTLOGIX_FRONTEND_URL=http://127.0.0.1:5174

# Proteccion del acceso y duracion de sesiones.
SMARTLOGIX_MAX_LOGIN_ATTEMPTS=5
SMARTLOGIX_LOGIN_LOCK_MINUTES=15
SMARTLOGIX_EMAIL_VERIFICATION_HOURS=24
SMARTLOGIX_PASSWORD_RESET_MINUTES=30
SMARTLOGIX_REFRESH_TOKEN_DAYS=14
SMARTLOGIX_MAIL_FROM=no-reply@smartlogix.local

# En desarrollo se traza el 100 % para facilitar la demostracion. En produccion
# puede reducirse, por ejemplo, a 0.10.
SMARTLOGIX_TRACING_SAMPLE_RATE=1.0

# Los datos iniciales solo se crean cuando esta opcion se habilita explicitamente.
SMARTLOGIX_SEED_ENABLED=true
SMARTLOGIX_SEED_ADMIN_PASSWORD=REEMPLAZAR_PASSWORD_ADMIN
SMARTLOGIX_SEED_USER_PASSWORD=REEMPLAZAR_PASSWORD_USUARIO
SMARTLOGIX_SEED_WAREHOUSE_PASSWORD=REEMPLAZAR_PASSWORD_BODEGUERO
SMARTLOGIX_SEED_CUSTOMER_PASSWORD=REEMPLAZAR_PASSWORD_CLIENTE

# PostgreSQL local. Use una clave diferente para el administrador y cada servicio.
SMARTLOGIX_DB_ADMIN_PASSWORD=REEMPLAZAR_PASSWORD_ADMIN_POSTGRES
SMARTLOGIX_DB_AUTH_PASSWORD=REEMPLAZAR_PASSWORD_DB_AUTH
SMARTLOGIX_DB_INVENTORY_PASSWORD=REEMPLAZAR_PASSWORD_DB_INVENTARIO
SMARTLOGIX_DB_ORDER_PASSWORD=REEMPLAZAR_PASSWORD_DB_PEDIDOS
SMARTLOGIX_DB_SHIPMENT_PASSWORD=REEMPLAZAR_PASSWORD_DB_ENVIOS
